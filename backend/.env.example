MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/parkassist?retryWrites=true&w=majority
MONGO_DB=Park_Assist
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@parkassist.local
ADMIN_PASSWORD=ChangeMe123!
PORT=5000
# Optional: absolute path to Firebase service-account JSON. Do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email Notification System (SMTP)
# Examples: Gmail (smtp.gmail.com / 587), SendGrid, Outlook, Mailtrap, etc.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@parkassist.local

